# Copy this file to .env and adjust values for your local environment.
# All defaults here target the emulators defined in docker-compose.yml.

# ── SQL Server (Service Bus Emulator dependency) ──────────────────────────────
# Must meet SQL Server complexity rules (upper + lower + digit + symbol).
MSSQL_SA_PASSWORD=Dev!Strong1Pass

# ── Azure Service Bus — Emulator ──────────────────────────────────────────────
# Points to the servicebus-emulator container.
# UseDevelopmentEmulator=true tells the SDK to skip TLS and namespace resolution.
SERVICEBUS_CONNECTION=Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;UseDevelopmentEmulator=true;

# ── Azure Storage — Azurite ───────────────────────────────────────────────────
# Full connection string required (UseDevelopmentStorage=true only resolves to 127.0.0.1).
AZURE_STORAGE_CONNECTION=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1

# ── Service Bus entity names (all queues — Basic tier, no topics) ─────────────
# ingestion-func: outbound dataset-available events + historical work queue.
SERVICE_BUS_QUEUE_NAME=raw-energy-events
DEAD_LETTER_QUEUE_NAME=pvdaq-dead-letter
PVDAQ_HISTORICAL_QUEUE_NAME=pvdaq-historical-work
# processing-func: inbound trigger queue (ProcessDatasetFunction.cs ServiceBusTrigger)
# and outbound validated-dataset queue (target name per ADR 0001/0002 — R3.9 renames
# the code to match; set now so R0's emulator topology doesn't need to change again).
SERVICEBUS_QUEUE_NAME=raw-energy-events
SERVICEBUS_BRONZE_QUEUE_NAME=dataset-validated

# ── Ingestion function — OEDI / PVDAQ settings ────────────────────────────────
OEDI_BUCKET_URL=https://oedi-data-lake.s3.amazonaws.com
OEDI_SYSTEMS_KEY=pvdaq/csv/systems_20250729.csv
OEDI_DATA_PREFIX=pvdaq/csv/pvdata
OEDI_HISTORICAL_PREFIX=pvdaq/2023-solar-data-prize
PVDAQ_SITE_IDS=
PVDAQ_SITE_COUNT=30
PVDAQ_LOOKBACK_HOURS=24
PVDAQ_CRON_SCHEDULE=0 0 * 29 2 *
PVDAQ_HISTORICAL_SITE_IDS=9068,9069,2107,7333
PVDAQ_HISTORICAL_CRON_SCHEDULE=0 41 * * * *
IDEMPOTENCY_TABLE_NAME=pvdaqidempotency
FILE_TRACKING_TABLE_NAME=PvdaqFileTracking
TENANT_ID=research
MAPPING_VERSION_PVDAQ=unknown
SCHEMA_VERSION_PVDAQ=v1
# Selects ingestion-func's local (Blob/Azurite) storage + Service Bus connection-string
# branch instead of the cloud DataLake/DefaultAzureCredential branch (function_app.py:117).
STORAGE_EMULATOR=true
# ADLS Gen2 bronze landing container (historical ingestion path — src/config.py:176-177).
ADLS_ACCOUNT_URL=http://azurite:10000/devstoreaccount1
ADLS_CONTAINER_NAME=bronze

# ── Processing function ───────────────────────────────────────────────────────
SCHEMA_REGISTRY_CONTAINER=schema-registry
# SCHEMA_REGISTRY_ACCOUNT is only consulted when SCHEMA_REGISTRY_BLOB_CONNECTION isn't
# exactly "UseDevelopmentStorage=true" (Program.cs:107-109) — set for completeness even
# though it won't resolve inside the compose network until that check is fixed (ADR 0005/R3.6).
SCHEMA_REGISTRY_ACCOUNT=devstoreaccount1
BRONZE_FILESYSTEM=bronze
OTEL_SERVICE_NAME=dataset-processing-func-local
APPLICATIONINSIGHTS_CONNECTION_STRING=
