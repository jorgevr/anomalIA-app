      "updated": 1,
      "link": null,
      "locked": false,
      "text": "🗄  Azure Table Storage  —  PvdaqFileTracking\nhttp://127.0.0.1:10002/devstoreaccount1\n\nstates:  Queued  →  Processing  →  Completed  /  Failed\nkeys:  PK = site_id    RK = s3_key + version\nstores:  storage_path, file_hash, row_count, metadata_path, ingestion_id,\n             source_url, ingestion_time, correlation_id, last_modified",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "🗄  Azure Table Storage  —  PvdaqFileTracking\nhttp://127.0.0.1:10002/devstoreaccount1\n\nstates:  Queued  →  Processing  →  Completed  /  Failed\nkeys:  PK = site_id    RK = s3_key + version\nstores:  storage_path, file_hash, row_count, metadata_path, ingestion_id,\n             source_url, ingestion_time, correlation_id, last_modified",
      "lineHeight": 1.3
    },

