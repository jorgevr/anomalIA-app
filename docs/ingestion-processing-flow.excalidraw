    {
      "id": "ingnote",
      "type": "text",
      "x": 80,
      "y": 710,
      "width": 1340,
      "height": 260,
      "angle": 0,
      "strokeColor": "#5f3dc4",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "seed": 1901,
      "version": 1,
      "versionNonce": 19010,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "✎  worker pipeline  (per CSV file)\n     ━━━━━━━━━━━━━━━━━━━━━━━━━\n     0.  Deserialize work-item  →  validate  Draft202012  JSON-Schema\n     1.  tracker.get_versions()  →  version = max + 1   (append-only)\n     2.  tracker.mark_processing()\n     3.  adls.stream_upload(source_url → file_path)\n             returns   (bytes_written,  sha256,  row_count)\n     4.  adls.write_json(metadata.json)   — conforms to contracts/metadata-file.json\n     5.  tracker.mark_completed(hash, path, row_count, …)\n     6.  build_dataset_envelope(...)  →  emitter.emit_cloudevent()\n     ↳  observability:   correlation_id,  traceparent,  InvocationStats",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "✎  worker pipeline  (per CSV file)\n     ━━━━━━━━━━━━━━━━━━━━━━━━━\n     0.  Deserialize work-item  →  validate  Draft202012  JSON-Schema\n     1.  tracker.get_versions()  →  version = max + 1   (append-only)\n     2.  tracker.mark_processing()\n     3.  adls.stream_upload(source_url → file_path)\n             returns   (bytes_written,  sha256,  row_count)\n     4.  adls.write_json(metadata.json)   — conforms to contracts/metadata-file.json\n     5.  tracker.mark_completed(hash, path, row_count, …)\n     6.  build_dataset_envelope(...)  →  emitter.emit_cloudevent()\n     ↳  observability:   correlation_id,  traceparent,  InvocationStats",
      "lineHeight": 1.3
    },

